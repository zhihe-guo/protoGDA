# codebase-memory-mcp 项目级忽略规则（gitignore 语法）
# 排除数据 / 检查点 / 缓存 / 二进制文件，避免污染代码知识图谱

# 大体积数据与检查点目录（仅根层级；src/data 是源代码模块，保留）
/data/
/dataset/
/checkpoints/
/runs/
/wandb/
/tdc/
.specstory/

# baselines 内部的数据目录（非源码）
baselines/**/data/

# 二进制 / 序列化数据文件
*.pt
*.pth
*.pkl
*.npz
*.npy
*.parquet
*.7z
*.zip
*.gz
*.tar
*.h5
*.hdf5
*.db
*.sqlite
*.onnx
*.ckpt
*.bin

# 缓存与构建产物
__pycache__/
.ipynb_checkpoints/
*.egg-info/
.eggs/
dist/
build/

# IDE
.idea/
.vscode/
*.swp
*.swo
