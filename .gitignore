#  re-implemented inside scripts/cv_runner.py — see THIRD_PARTY_NOTICES.md)
/baselines/transcdr/

# Private agent/history folders
.specstory/

# Data caches inside baselines (non-source; mirror .cbmignore)
baselines/**/data/
baselines/**/*.pkl

# External data caches (mirror .cbmignore): not source, not redistributed
/dataset/

# Release model weights: explicitly tracked despite the global *.pt rule
!pretrained/
!pretrained/**/
!pretrained/**/*.pt
!pretrained/**/*.json

